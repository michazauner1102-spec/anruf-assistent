# ── Variante A: lokales Modell über Ollama (nichts verlässt den Rechner) ──
MODEL_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# Beliebiges Modell, das du per "ollama pull" geladen hast.
OLLAMA_MODEL=llama3.1:8b

# ── Variante B: Cloud-Anbieter mit OpenAI-kompatibler API ──
# Funktioniert mit OpenAI, Groq, OpenRouter, Together, Ollama Cloud u. a.
# MODEL_PROVIDER=openai
# CLOUD_BASE_URL=https://api.openai.com/v1
# CLOUD_MODEL=gpt-4o-mini
# CLOUD_API_KEY=...

# Beides lässt sich auch zur Laufzeit im Einstellungsbereich der App überschreiben.
